# Local credentials (copy switchbot_secrets.example.ps1 to create)
switchbot_secrets.ps1

# Local environment settings (copy config.example.ps1 to create)
config.ps1

# Author's private notes (e.g. MANUAL.md, the original build log with real IPs,
# paths and device ids). The shareable version lives in docs/.
private/

# Runtime state written by the toggle scripts
state/

# Jekyll build output (docs site)
docs/_site/
docs/.jekyll-cache/
Gemfile.lock
